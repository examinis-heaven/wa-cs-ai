# Optional local test/health HTTP server
PORT=3001

# WhatsApp Web (wwebjs) LocalAuth session
WWEBJS_CLIENT_ID=cs-bot
WWEBJS_DATA_PATH=.wwebjs_auth
WWEBJS_HEADLESS=true

# 9router (OpenAI-compatible LLM endpoint)
ROUTER_BASE_URL=http://127.0.0.1:20128/v1
ROUTER_API_KEY=your-9router-api-key
ROUTER_MODEL=CS
ROUTER_TIMEOUT_MS=90000
ROUTER_FALLBACK_MODELS=

# Skill & Knowledge paths
SKILL_PATH=C:\project\CS\skills\cs-produk-marketplace\SKILL.md
KNOWLEDGE_PATH=C:\project\CS\skills\cs-produk-marketplace\references\produk.md

# Conversation memory (disimpan per customer di folder sessions/ agar tetap nyambung walau bot restart)
SESSION_DIR=sessions
MAX_HISTORY_MESSAGES=20
HISTORY_TTL_MINUTES=1440

# Debounce per nomor WA (ms) agar beberapa bubble chat digabung sebelum dijawab (10000 = 10 detik)
MESSAGE_DEBOUNCE_MS=10000

# SQLite Product Catalog Database
CATALOG_DB_PATH=data/catalog.db

# Optional: WhatsApp chatId penjual untuk notifikasi eskalasi (contoh: 6281234567890@c.us)
OWNER_NOTIFY_CHAT_ID=

# Logging (disimpan di folder logs/app-YYYY-MM-DD.log & logs/error-YYYY-MM-DD.log)
LOG_DIR=logs
LOG_LEVEL=info

# Optional: Koordinat pin Shareloc WhatsApp asli (Titik COD)
LOCATION_COD_LAT=
LOCATION_COD_LNG=
LOCATION_COD_NAME=Titik COD
LOCATION_COD_URL=
